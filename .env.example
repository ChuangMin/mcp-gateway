# Copy to .env for docker compose, or export these when running the Gateway directly.

# Public URL clients use to reach the Gateway (used for OAuth metadata and Profile URLs).
PUBLIC_BASE_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts Upstream Server credentials at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Entra ID app registration for the organization's one Entra Tenant (GUIDs).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional overrides (defaults shown). Tests point these at fakes.
# ENTRA_AUTHORITY_URL=https://login.microsoftonline.com
# GRAPH_BASE_URL=https://graph.microsoft.com

# Only when running outside docker compose:
# DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
# PORT=3000
# HOST=0.0.0.0
# WEB_DIST_DIR=packages/web/dist
